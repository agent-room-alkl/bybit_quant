{
  "version": 2,
  "crons": [
    {
      "path": "/api/tick",
      "schedule": "* * * * *"
    }
  ],
  "builds": [
    {
      "src": "api/tick.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["lib/**"], "maxLambdaSize": "250mb" }
    },
    {
      "src": "api/status.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["lib/**"] }
    }
  ]
}
